#!/bin/bash

# omarchy:summary=Install Steam
# omarchy:requires-sudo=true
# omarchy:examples=omarchy-install-gaming-steam

# Toggles omarchy.gaming.steam.enable rather than installing a package: the
# option carries the supporting configuration too. See
# omarchy-gaming-component.

set -euo pipefail

exec omarchy-opt-set "$(omarchy-gaming-component steam)" true
