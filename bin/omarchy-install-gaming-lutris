#!/bin/bash

# omarchy:summary=Install Lutris
# omarchy:requires-sudo=true
# omarchy:examples=omarchy-install-gaming-lutris

# Toggles omarchy.gaming.lutris.enable rather than installing a package: the
# option carries the supporting configuration too. See
# omarchy-gaming-component.

set -euo pipefail

exec omarchy-opt-set "$(omarchy-gaming-component lutris)" true
