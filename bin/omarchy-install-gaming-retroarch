#!/bin/bash

# omarchy:summary=Install RetroArch
# omarchy:requires-sudo=true
# omarchy:examples=omarchy-install-gaming-retroarch

# Toggles omarchy.gaming.retroarch.enable rather than installing a package: the
# option carries the supporting configuration too. See
# omarchy-gaming-component.

set -euo pipefail

exec omarchy-opt-set "$(omarchy-gaming-component retroarch)" true
