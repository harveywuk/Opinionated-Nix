#!/bin/bash

# omarchy:summary=Install Xbox controller support
# omarchy:requires-sudo=true
# omarchy:examples=omarchy-install-gaming-xbox-controllers

# Toggles omarchy.gaming.xboxControllers.enable rather than installing a package: the
# option carries the supporting configuration too. See
# omarchy-gaming-component.

set -euo pipefail

exec omarchy-opt-set "$(omarchy-gaming-component xbox-controllers)" true
