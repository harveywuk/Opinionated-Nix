#!/bin/bash

# omarchy:summary=Remove fingerprint authentication from sudo, polkit, and lock screen

set -e

# Nix deviation: upstream sed-edits /etc/pam.d/{sudo,polkit-1}, removes
# /etc/pam.d/omarchy-lock-fingerprint and drops the packages. All of that is
# declarative here — see the note in omarchy-setup-security-fingerprint. This
# script only deletes the enrolled prints.

echo -e "\e[32mRemoving enrolled fingerprints.\n\e[0m"

if omarchy-cmd-present fprintd-delete; then
  sudo fprintd-delete "$USER"
fi

echo "To disable fingerprint authentication itself, set"
echo "omarchy.fido2_auth.fingerprint_support = false and rebuild."
