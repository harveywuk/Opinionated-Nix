#!/bin/bash

# omarchy:summary=Map a gaming component to its omarchy option path
# omarchy:args=<component>
# omarchy:examples=omarchy-gaming-component steam

# Shared by the omarchy-install-gaming-* / omarchy-remove-gaming-* wrappers.
# These are options rather than packages because the option does more than
# install: gaming.steam also enables programs.steam, Proton-GE and the Remote
# Play firewall openings, and gaming.xboxControllers loads xpadneo. Installing
# the bare package would silently skip all of that.

set -euo pipefail

case "${1-}" in
  steam)            echo "gaming.steam.enable" ;;
  heroic)           echo "gaming.heroic.enable" ;;
  lutris)           echo "gaming.lutris.enable" ;;
  retroarch)        echo "gaming.retroarch.enable" ;;
  moonlight)        echo "gaming.moonlight.enable" ;;
  xbox-cloud)       echo "gaming.xboxCloud.enable" ;;
  geforce-now)      echo "gaming.geforceNow.enable" ;;
  xbox-controllers) echo "gaming.xboxControllers.enable" ;;
  "")
    echo "omarchy-gaming-component: no component given" >&2
    exit 64
    ;;
  *)
    echo "omarchy-gaming-component: unknown component '$1'" >&2
    exit 2
    ;;
esac
