#!/bin/bash

# omarchy:summary=Install NVIDIA GeForce NOW
# omarchy:requires-sudo=true
# omarchy:examples=omarchy-install-gaming-geforce-now

# Toggles omarchy.gaming.geforceNow.enable rather than installing a package: the
# option carries the supporting configuration too. See
# omarchy-gaming-component.

set -euo pipefail

exec omarchy-opt-set "$(omarchy-gaming-component geforce-now)" true
