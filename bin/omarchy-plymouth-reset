#!/bin/bash

# omarchy:summary=Restore the default Omarchy Plymouth boot theme and SDDM login screen
# omarchy:requires-sudo=true

# Nix deviation: upstream calls omarchy-refresh-plymouth + omarchy-refresh-sddm,
# which stage /usr/share/plymouth and regenerate the initramfs. Both are
# declarative here (packages/plymouth-theme-omarchy.nix + the SDDM module), so
# resetting means rebuilding, not mutating the running system.
echo "Plymouth and SDDM are managed declaratively on omarchy-nix." >&2
echo "Rebuild to restore the defaults: sudo nixos-rebuild switch" >&2
