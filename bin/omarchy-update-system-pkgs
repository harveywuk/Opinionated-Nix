#!/bin/bash

# omarchy:summary=Update nix channels and flake inputs, then rebuild the system
# omarchy:requires-sudo=true

# Replaces Omarchy's `pacman -Syu`. On NixOS a system update is: refresh the
# inputs the configuration is pinned to, then rebuild from them. Both halves
# matter -- rebuilding without updating inputs is a no-op, and updating inputs
# without rebuilding changes nothing on disk.
#
# Channels are updated too when any are configured. A flakes-only system
# usually has none, so that step is skipped rather than failing.

set -euo pipefail

# --- channels -------------------------------------------------------------
if command -v nix-channel >/dev/null 2>&1 && [[ -n "$(nix-channel --list 2>/dev/null)" ]]; then
  echo -e "\e[32m\nUpdate nix channels\e[0m"
  sudo nix-channel --update
else
  echo -e "\e[90mNo nix channels configured -- skipping.\e[0m"
fi

# --- flake ----------------------------------------------------------------
flake_dir="$(omarchy-nix-flake-dir)"

echo -e "\e[32m\nUpdate flake inputs in $flake_dir\e[0m"
# The flake may live somewhere only root can write (/etc/nixos), so fall back
# rather than dying on a permission error the user can do nothing about here.
if [[ -w $flake_dir/flake.lock ]]; then
  nix flake update --flake "$flake_dir"
else
  sudo nix flake update --flake "$flake_dir"
fi

echo -e "\e[32m\nRebuild the system\e[0m"
# No #host: nixos-rebuild defaults to nixosConfigurations.$(hostname), which is
# what a single-host flake wants and what a multi-host flake keys on anyway.
sudo nixos-rebuild switch --flake "$flake_dir"
