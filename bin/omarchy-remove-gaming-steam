#!/bin/bash

# omarchy:summary=Remove Steam
# omarchy:requires-sudo=true
# omarchy:examples=omarchy-remove-gaming-steam

# Toggles omarchy.gaming.steam.enable rather than installing a package: the
# option carries the supporting configuration too. See
# omarchy-gaming-component.

set -euo pipefail

exec omarchy-opt-unset "$(omarchy-gaming-component steam)"
