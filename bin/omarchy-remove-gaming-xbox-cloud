#!/bin/bash

# omarchy:summary=Remove Xbox Cloud Gaming
# omarchy:requires-sudo=true
# omarchy:examples=omarchy-remove-gaming-xbox-cloud

# Toggles omarchy.gaming.xboxCloud.enable rather than installing a package: the
# option carries the supporting configuration too. See
# omarchy-gaming-component.

set -euo pipefail

exec omarchy-opt-unset "$(omarchy-gaming-component xbox-cloud)"
