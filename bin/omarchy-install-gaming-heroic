#!/bin/bash

# omarchy:summary=Install Heroic
# omarchy:requires-sudo=true
# omarchy:examples=omarchy-install-gaming-heroic

# Toggles omarchy.gaming.heroic.enable rather than installing a package: the
# option carries the supporting configuration too. See
# omarchy-gaming-component.

set -euo pipefail

exec omarchy-opt-set "$(omarchy-gaming-component heroic)" true
