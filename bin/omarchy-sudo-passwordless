#!/bin/bash

# omarchy:summary=Allow wheel to run sudo without a password
# omarchy:requires-sudo=true
# omarchy:examples=omarchy-sudo-passwordless

# Sets security.sudo.wheelNeedsPassword = false. This weakens a real boundary:
# any process running as you can then take root without prompting. Confirm
# rather than doing it silently from a menu.
#
# OPEN QUESTION -- deliberately left broad for now, to be revisited.
# This is blanket: every wheel user, every command. That sits awkwardly next to
# this port's own stance elsewhere, which is to scope NOPASSWD narrowly
# (timedatectl set-timezone) or refuse it outright when it cannot be scoped
# (see the omarchy-dns grant in OMARCHY4-PORT.md). Upstream's implementation
# has not been compared -- it may write something narrower than this.
#
# If it turns out the recurring friction is only nixos-rebuild, a grant scoped
# to that would match the timedatectl precedent and give up much less.

set -euo pipefail

echo -e "\e[33mThis lets anything running as your user become root without a"
echo -e "password prompt, including scripts you did not start yourself.\e[0m"
read -rp "Continue? [y/N] " reply
[[ ${reply,,} == y || ${reply,,} == yes ]] || { echo "Cancelled."; exit 0; }

exec omarchy-opt-set security.sudo.wheelNeedsPassword false
